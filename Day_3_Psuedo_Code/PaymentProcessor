CLASS Transaction<T>
    transactionId
    method : T
    amount

    METHOD constructor(id, method, amount)
        transactionId ← id
        method ← method
        amount ← amount

    METHOD processTransaction()
        PRINT "Processing " + method + " payment of " + amount

MAIN
    txn1 ← Transaction<String>("TXN1", "UPI", 500)
    txn2 ← Transaction<String>("TXN2", "Card", 2000)
    txn3 ← Transaction<String>("TXN3", "NetBanking", 10000)

    txn1.processTransaction()
    txn2.processTransaction()
    txn3.processTransaction()